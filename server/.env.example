# Leave DATABASE_URL empty to use a local SQLite file (kalakari.db).
# In production (Render), paste your Postgres connection string here (e.g. from Neon).
DATABASE_URL=

# Port the API listens on (the site expects 8000 when testing locally).
PORT=8000

# Secret key for the admin endpoints (send it as the X-Admin-Key header).
ADMIN_KEY=change-me

# Your site's address, so only it can call the API. Comma-separated.
ALLOWED_ORIGINS=https://kalakarii.netlify.app,http://127.0.0.1:5500,http://localhost:5500

# Optional: email yourself when a new enquiry arrives (Gmail needs an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
