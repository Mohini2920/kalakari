{
  "name": "kalakari-api",
  "version": "1.0.0",
  "description": "Backend for Kalakari: example pieces, enquiries and newsletter signups.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  }
}
